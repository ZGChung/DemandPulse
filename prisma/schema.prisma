// DemandPulse Database Schema
// Designed with privacy and security as first principles

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Core requirement tracking with privacy controls
model Requirement {
  id                     String   @id @default(cuid())
  
  // Requirement content (user-provided)
  originalRequirement    String   @db.Text
  summarizedRequirement  String   @db.Text
  
  // Context from Claude Code
  conversationId         String
  workspacePath          String?
  detectedAt             DateTime
  
  // Consent information
  dataCollectionConsent  Boolean  @default(false)
  contactConsent         Boolean  @default(false)
  anonymizationConsent   Boolean  @default(true)
  userProvidedEmail      String?  @db.VarChar(255)
  consentedAt            DateTime?

  // User association (optional - for authenticated users)
  userId                String?
  
  // Processing status
  status                 RequirementStatus @default(PENDING)
  processedAt            DateTime?
  
  // Privacy controls
  anonymizedData         Json?    @db.JsonB // Stores anonymized version if consent given
  dataRetentionDays      Int      @default(365)
  scheduledDeletionAt    DateTime?
  
  // Timestamps
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  // Indexes for performance and privacy compliance
  @@index([conversationId])
  @@index([status])
  @@index([scheduledDeletionAt])
  @@index([userId])
  @@unique([conversationId, detectedAt])
  
  // Privacy constraint: If anonymization is consented, email must be null
  // Note: This constraint should be enforced at application level in Prisma 7.3.0
  // @@check("(anonymizationConsent = true AND userProvidedEmail IS NULL) OR anonymizationConsent = false")
  
  // Relationships
  processing       RequirementProcessing?
  clusters         RequirementCluster[] @relation("ClusterRequirements")
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// AI processing results for requirements
model RequirementProcessing {
  id               String   @id @default(cuid())
  requirementId    String   @unique
  requirement      Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  
  // AI analysis results
  embeddings       Json?    @db.JsonB // Vector embeddings for clustering
  categories       String[] // AI-detected categories
  confidence       Float    @default(0.0)
  processingLog    String   @db.Text
  
  // Timestamps
  processedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([requirementId])
}

// Clustered requirements (similar needs grouped together)
model RequirementCluster {
  id               String   @id @default(cuid())
  name             String
  description      String   @db.Text
  centroidEmbedding Json?   @db.JsonB // Center point of cluster
  
  // Statistics
  requirementCount Int      @default(0)
  firstDetectedAt  DateTime
  lastDetectedAt   DateTime @updatedAt
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relationships
  requirements     Requirement[] @relation("ClusterRequirements")
  
  @@index([createdAt])
  @@index([requirementCount])
}

// Trend analysis over time
model TrendAnalysis {
  id               String   @id @default(cuid())
  date             DateTime @unique // Date of analysis (daily)
  
  // Trend metrics
  totalRequirements Int     @default(0)
  newClusters       Int     @default(0)
  topCategories     Json    @db.JsonB // JSON array of top categories
  
  // Growth metrics
  growthRate        Float   @default(0.0)
  trendingKeywords  String[] // Keywords showing growth
  
  // Timestamps
  analyzedAt        DateTime @default(now())
  
  @@index([date])
}

// Privacy audit log (GDPR compliance)
model PrivacyAuditLog {
  id               String   @id @default(cuid())
  
  // Action information
  action           PrivacyAction
  entityType       String   // "Requirement", "User", etc.
  entityId         String?
  
  // Actor information (system or user)
  actorType        ActorType @default(SYSTEM)
  actorId          String?
  
  // Changes made
  changes          Json?    @db.JsonB
  reason           String?  @db.Text
  
  // Timestamps
  performedAt      DateTime @default(now())
  
  // Indexes for compliance reporting
  @@index([action])
  @@index([entityType, entityId])
  @@index([performedAt])
}

// Data deletion queue for GDPR compliance
model DataDeletionQueue {
  id               String   @id @default(cuid())
  
  // What to delete
  entityType       String   // "Requirement", "UserData", etc.
  entityId         String
  deletionReason   DeletionReason
  
  // Processing status
  status           DeletionStatus @default(PENDING)
  scheduledAt      DateTime
  processedAt      DateTime?
  
  // Audit information
  requestedBy      String?  // User ID or system process
  auditLogId       String?  // Link to audit log
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@unique([entityType, entityId])
  @@index([status])
  @@index([scheduledAt])
}

// Enums for type safety
enum RequirementStatus {
  PENDING
  PROCESSING
  PROCESSED
  CLUSTERED
  REJECTED
  DELETED
}

enum PrivacyAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  ANONYMIZE
  CONSENT_CHANGE
}

enum ActorType {
  SYSTEM
  USER
  ADMIN
  AUTOMATED
}

enum DeletionReason {
  RETENTION_EXPIRED
  USER_REQUEST
  CONSENT_REVOKED
  SYSTEM_CLEANUP
}

enum DeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// NextAuth.js User model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  accounts      Account[]
  sessions      Session[]

  // Link to requirements (optional)
  requirements  Requirement[]

  @@index([email])
  @@index([createdAt])
}

// NextAuth.js Account model (for OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth.js Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

// NextAuth.js VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
