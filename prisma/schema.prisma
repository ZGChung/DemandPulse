// DemandPulse Database Schema for SQLite testing
// Simplified version for API endpoint testing

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

// Core requirement tracking with privacy controls
model Requirement {
  id                     String   @id @default(cuid())

  // Requirement content (user-provided)
  originalRequirement    String
  summarizedRequirement  String
  embedding              Json?      // Vector embedding for clustering

  // Context from Claude Code
  conversationId         String
  workspacePath          String?
  detectedAt             DateTime

  // Consent information
  dataCollectionConsent  Boolean  @default(false)
  contactConsent         Boolean  @default(false)
  anonymizationConsent   Boolean  @default(true)
  userProvidedEmail      String?
  consentedAt            DateTime?

  // User association (optional - for authenticated users)
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Processing status
  status                 RequirementStatus @default(PENDING)
  processedAt            DateTime?

  // Privacy controls
  anonymizedData         Json?    // Stores anonymized version if consent given
  dataRetentionDays      Int      @default(365)
  scheduledDeletionAt    DateTime?

  // Timestamps
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Clustering relationships
  clusters               RequirementCluster[]

  // Indexes for performance and privacy compliance
  @@index([conversationId])
  @@index([status])
  @@index([scheduledDeletionAt])
  @@index([userId])
  @@unique([conversationId, detectedAt])
}

// Clusters of similar requirements for trend analysis
model RequirementCluster {
  id                String   @id @default(cuid())
  name              String
  description       String
  centroidEmbedding Json?    // Centroid vector embedding for the cluster
  requirementCount  Int      @default(0)
  firstDetectedAt   DateTime
  lastDetectedAt    DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  requirements      Requirement[]

  // Indexes
  @@index([requirementCount])
  @@index([firstDetectedAt])
  @@index([lastDetectedAt])
}

// Privacy audit log (GDPR compliance)
model PrivacyAuditLog {
  id               String   @id @default(cuid())

  // Action information
  action           PrivacyAction
  entityType       String   // "Requirement", "User", etc.
  entityId         String?

  // Actor information (system or user)
  actorType        ActorType @default(SYSTEM)
  actorId          String?

  // Changes made
  changes          Json?
  reason           String?

  // Timestamps
  performedAt      DateTime @default(now())

  // Indexes for compliance reporting
  @@index([action])
  @@index([entityType, entityId])
  @@index([performedAt])
}

// Data deletion queue for GDPR compliance
model DataDeletionQueue {
  id               String   @id @default(cuid())

  // What to delete
  entityType       String   // "Requirement", "UserData", etc.
  entityId         String
  deletionReason   DeletionReason

  // Processing status
  status           DeletionStatus @default(PENDING)
  scheduledAt      DateTime
  processedAt      DateTime?

  // Audit information
  requestedBy      String?  // User ID or system process
  auditLogId       String?  // Link to audit log

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
  @@index([scheduledAt])
}

// NextAuth.js User model (simplified for SQLite)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  accounts            Account[]
  sessions            Session[]
  requirements        Requirement[]
  organizationMembers OrganizationMember[]

  @@index([email])
  @@index([createdAt])
}

// P3-12: Organizations (teams) for org-level board and permissions
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]

  @@index([slug])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrgRole {
  MEMBER
  ADMIN
  OWNER
}

// NextAuth.js Account model (simplified for SQLite)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth.js Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

// NextAuth.js VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Enums for type safety
enum RequirementStatus {
  PENDING
  PROCESSING
  PROCESSED
  CLUSTERED
  REJECTED
  DELETED
}

enum PrivacyAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  ANONYMIZE
  CONSENT_CHANGE
}

enum ActorType {
  SYSTEM
  USER
  ADMIN
  AUTOMATED
}

enum DeletionReason {
  RETENTION_EXPIRED
  USER_REQUEST
  CONSENT_REVOKED
  SYSTEM_CLEANUP
}

enum DeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UserRole {
  USER
  ANALYST
  ADMIN
}