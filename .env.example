# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DemandPulse

# API Keys (Keep these secret!)
# Embeddings: use Gemini free tier (gemini-embedding-001) for clustering.
GEMINI_API_KEY=your_gemini_api_key_here
# LLM (categorization / keywords / summary): use MiniMax Coding Plan key.
MINIMAX_API_KEY=your_minimax_coding_plan_key_here
MINIMAX_GROUP_ID=

# Database
# For local development (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/demandpulse

# For Neon PostgreSQL (production/development):
# DATABASE_URL=postgresql://neondb_owner:[password]@ep-[instance].pooler.us-east-2.aws.neon.tech/demandpulse?sslmode=require&connect_timeout=30

# For Prisma Data Platform (alternative):
# DATABASE_URL="prisma+postgres://prisma:password@aws-us-east-1.prisma-data.com/?api_key=your_api_key"

# Redis (for rate limiting and caching)
# For local development:
# REDIS_URL=redis://localhost:6379
# For Upstash Redis (production):
# REDIS_URL=rediss://:[password]@[region].upstash.io:6379

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Feature flags
ENABLE_CLAUDE_CODE_PLUGIN=true
ENABLE_AI_PROCESSING=true

# Plugin API Authentication
PLUGIN_API_KEY=your_plugin_api_key_here

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here

# Email configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@demandpulse.dev
EMAIL_ENABLED=true
EMAIL_USE_MOCK=true

# Field-level encryption (AES-GCM)
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=your_encryption_key_here_base64