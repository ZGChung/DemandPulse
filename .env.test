# Test environment variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DemandPulse

# Database (SQLite for tests)
DATABASE_URL=file:./test.db

# Authentication
NEXTAUTH_SECRET=test_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (not needed for tests)
GITHUB_ID=test_github_id
GITHUB_SECRET=test_github_secret

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# Feature flags
ENABLE_CLAUDE_CODE_PLUGIN=true
ENABLE_AI_PROCESSING=false

# Plugin API Authentication
PLUGIN_API_KEY=test-plugin-api-key-123

# Sentry (disabled for tests)
SENTRY_DSN=

# CSRF secret
CSRF_SECRET=test-csrf-secret

# Email configuration (Resend)
RESEND_API_KEY=re_test_key
RESEND_FROM_EMAIL=notifications@demandpulse.dev
EMAIL_ENABLED=true
EMAIL_USE_MOCK=true