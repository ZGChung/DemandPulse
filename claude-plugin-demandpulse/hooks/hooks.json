{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{plugin_dir}}/bin/hook-handler.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{plugin_dir}}/bin/hook-handler.mjs\""
          }
        ]
      }
    ]
  }
}
